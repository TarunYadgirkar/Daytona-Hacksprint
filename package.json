{
  "name": "safeship",
  "version": "0.1.0",
  "private": true,
  "description": "Adversarial PR verification gate. Extracts a PR's behavioral claim, generates tests designed to break it, and runs them in a sandbox for real pass/fail evidence.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "record:coderabbit": "tsx scripts/record-coderabbit.ts",
    "check:env": "tsx scripts/check-env.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@copilotkit/react-core": "latest",
    "@copilotkit/react-ui": "latest",
    "@copilotkit/runtime": "latest",
    "@daytona/sdk": "latest",
    "braintrust": "latest",
    "next": "^15.5.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
