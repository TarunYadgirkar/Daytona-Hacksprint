{"kind":"textbox","id":"sh/c3eh0jm9","slide":9,"text":"02","textPreview":"02","textChars":2,"textLines":1,"bbox":[466,274,72,42]}
{"kind":"textbox","id":"sh/d4ny9o3u","slide":9,"text":"A timeout is not\na code failure.","textPreview":"A timeout is not | a code failure.","textChars":32,"textLines":2,"bbox":[466,334,290,124]}
