# ---- Fireworks (claim extraction + adversarial test generation) ----
# OpenAI-compatible. Any OpenAI-shaped SDK works by swapping the base URL.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Verify this ID against the live catalog at fireworks.ai/models before the demo.
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# ---- Daytona (isolated sandbox for before/after test execution) ----
DAYTONA_API_KEY=
# DAYTONA_API_URL=            # only for self-hosted / non-default control plane
# DAYTONA_TARGET=

# ---- CodeRabbit (independent static AI review) ----
# cache = read pre-recorded verdicts from lib/fixtures (DEMO DEFAULT, always use on stage)
# cli   = shell out to the CodeRabbit CLI live (slow: 8-30 min, rate limited)
CODERABBIT_MODE=cache
CODERABBIT_API_KEY=

# ---- Braintrust (gate decision logging) ----
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=safeship

# ---- CopilotKit runtime ----
# Model for the chat agent. Separate from FIREWORKS_MODEL, which drives the pipeline.
COPILOT_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=
