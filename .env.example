# Required: Fireworks extracts the claim and generates adversarial tests.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# Required: Daytona executes generated tests against both revisions.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Optional: Braintrust records gate runs and human decisions.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=safeship

# Required on the public Vercel production domain. Preview deployments should
# additionally enable Vercel Authentication in Deployment Protection.
SAFESHIP_DEMO_ACCESS_CODE=

# Recorded mode streams bundled fixture events and calls no sponsor APIs.
# Use it for Playwright and deterministic local UI checks, never as a live demo.
# SAFESHIP_GATE_MODE=recorded
SAFESHIP_RECORDED_DELAY_MS=20

# Optional in the default cache mode. Required only to record live CLI reviews.
CODERABBIT_API_KEY=
CODERABBIT_MODE=cache
# Optional override. The recorder also auto-detects .tools/bin/coderabbit.
CODERABBIT_BIN=

# Optional public CopilotKit license key. The chat runtime itself uses the
# Fireworks API key configured above.
NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=
COPILOTKIT_MODEL=accounts/fireworks/models/kimi-k2p6
